# انسخ إلى .env أو .env.development وعبّئ القيم

NODE_ENV=development
PORT=8000

# API عام (HTTPS). التطوير: npm run dev:ngrok يملأ .env.ngrok.local تلقائياً
BASE_URL=
NGROK_URL=
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
PUBLIC_BASE_URL=
PRODUCTION_URL=

FRONTEND_HOST=https://your-frontend.example
FRONTEND_PUBLIC_URL=
CORS_ORIGIN=http://localhost:5173
NGROK_RELAX_CORS=true

SECRET_KEY=
DATABASE_URL=

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- PDF Question Extraction (Question Bank) ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_IMAGE_MODEL=gpt-image-1
TEACHER_CREATIVE_LOGO_PATH=next-logo.png
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
PDF_EXTRACTION_QUEUE_NAME=qb-pdf-extraction
PDF_EXTRACTION_WORKER_ENABLED=true
PDF_EXTRACTION_WORKER_CONCURRENCY=2
PDF_EXTRACTION_MAX_RETRIES=3
PDF_EXTRACTION_UPLOAD_DIR=uploads/qb-pdf-extraction
PDF_PYTHON_SCRIPTS_DIR=workers/pdf-extraction
PYTHON_PATH=python
PDF_RENDER_SCALE=2
PDF_OCR_ENABLED=true
PDF_VISION_ENABLED=true

# --- Mistral OCR (document / image text extraction) ---
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URL=
