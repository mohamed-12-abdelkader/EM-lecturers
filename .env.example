# انسخ إلى .env.development وعبّئ القيم

NODE_ENV=development
APP_ENV=development
PORT=8000

# --- URLs (Expo Go + ngrok) ---
# npm run dev:expo يملأ .env.ngrok.local تلقائياً
LOCAL_URL=http://localhost:8000
NGROK_URL=
BASE_URL=
API_URL=
# رابط الـ API العام داخل QR ولي الأمر (لو فاضي يستخدم API_URL)
CENTER_PUBLIC_API_URL=
PRODUCTION_URL=https://your-production-api.example

# ngrok: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# اختياري: دومين ثابت من ngrok (خطة مدفوعة)
NGROK_DOMAIN=
USE_NGROK=false
NGROK_RELAX_CORS=true

FRONTEND_HOST=https://your-frontend.example
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,exp://localhost:8081

SECRET_KEY=
DATABASE_URL=

# منطقة زمنية للمنصة (حضور الموظفين / المهام اليومية)
PLATFORM_TIMEZONE=Africa/Cairo

# Admin ↔ Employee staff chat
STAFF_CHAT_MAX_IMAGE_SIZE_MB=5
STAFF_CHAT_MAX_MESSAGE_LENGTH=4000
STAFF_CHAT_MESSAGE_EDIT_WINDOW_MINUTES=15
STAFF_CHAT_RATE_LIMIT_MESSAGES_PER_MINUTE=30
STAFF_CHAT_GROUP_NAME=فريق العمل

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Course PDF files (teacher upload / in-app viewer)
FILE_STORAGE_PROVIDER=cloudinary
COURSE_PDF_MAX_FILE_SIZE_MB=50
COURSE_PDF_SIGNED_URL_TTL_SECONDS=300
COURSE_PDF_STORAGE_FOLDER=course-pdfs
# Tenant platform images (avatar/favicon/og/hero) — 0 = unlimited (default)
TENANT_IMAGE_MAX_FILE_SIZE_MB=0

# Bunny (required by config — can be empty in local if unused)
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_PUBLIC_HOSTNAME=
BUNNY_ACCESS_KEY=
BUNNY_MEDIA_PATH=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_BASE=
BUNNY_STREAM_EMBED_BASE=
# Meeting recordings after LiveKit egress: bunny (default) | youtube
MEETING_RECORDING_PROVIDER=bunny
# LiveKit composite recording UI (em-recording app)
LK_RECORDING_BASE_URL=https://lk-recording.next-edu.online

# --- PDF Question Extraction (Question Bank) ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_IMAGE_MODEL=gpt-image-1
TEACHER_CREATIVE_LOGO_PATH=next-logo.png
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
PDF_EXTRACTION_QUEUE_NAME=qb-pdf-extraction
PDF_EXTRACTION_WORKER_ENABLED=true
PDF_EXTRACTION_WORKER_CONCURRENCY=2
PDF_EXTRACTION_MAX_RETRIES=3
PDF_EXTRACTION_UPLOAD_DIR=uploads/qb-pdf-extraction
PDF_PYTHON_SCRIPTS_DIR=workers/pdf-extraction
PYTHON_PATH=python
PDF_RENDER_SCALE=2
PDF_OCR_ENABLED=true
PDF_VISION_ENABLED=true

# --- Web Push Notifications (VAPID) ---
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain.com
WEB_PUSH_WORKER_ENABLED=true
WEB_PUSH_WORKER_INTERVAL_MS=2000
WEB_PUSH_WORKER_BATCH_SIZE=50
WEB_PUSH_MAX_ATTEMPTS=5

# --- WhatsApp gateway (wwebjs) ---
# Provision an app via POST /admin/apps on the gateway, then set:
WHATSAPP_GATEWAY_URL=http://localhost:3000
WHATSAPP_API_KEY=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WORKER_ENABLED=true
WHATSAPP_WORKER_INTERVAL_MS=2000
WHATSAPP_WORKER_BATCH_SIZE=20
WHATSAPP_MAX_ATTEMPTS=5

# --- DeepSeek (chatbots including WhatsApp technical support) ---
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com

# --- Mistral OCR / vision (document extraction + WhatsApp screenshot describe) ---
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_CHAT_MODEL=mistral-medium-latest
MISTRAL_VISION_CHAT_MODEL=mistral-medium-latest
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1
# Max upload size for /api/ocr/* in MB — 0 = unlimited (production large PDFs)
MISTRAL_OCR_MAX_FILE_SIZE_MB=512

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URL=
