GET http://localhost:8000/api/essay-exams/exams/1/my-grade
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NSwiZW1haWwiOiJzdHVkZW50QGV4YW1wbGUuY29tIiwicm9sZSI6InN0dWRlbnQiLCJqdGkiOiJ0ZXN0LXN0dWRlbnQtanRpIiwiaWF0IjoxNzU4NDIxNDY5LCJleHAiOjE3NTkwMjYyNjl9.xHkbWl1GE4_fojVCSGA0cMNgWDMOZ_EOtPA77de9wYY

### 9. جلب أسئلة الامتحان للطالب (اختبار إخفاء الأسئلة بعد الإرسال)
GET http://localhost:8000/api/essay-exams/exams/1/questions
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6NSwiZW1haWwiOiJzdHVkZW50QGV4YW1wbGUuY29tIiwicm9sZSI6InN0dWRlbnQiLCJqdGkiOiJ0ZXN0LXN0dWRlbnQtanRpIiwiaWF0IjoxNzU4NDIxNDY5LCJleHAiOjE3NTkwMjYyNjl9.xHkbWl1GE4_fojVCSGA0cMNgWDMOZ_EOtPA77de9wYY

### 10. جلب أسئلة الامتحان للمدرس (يجب أن يرى الأسئلة دائماً)
GET http://localhost:8000/api/essay-exams/exams/1/questions
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MSwiZW1haWwiOiJhZG1pbkBleGFtcGxlLmNvbSIsInJvbGUiOiJhZG1pbiIsImp0aSI6InRlc3QtanRpIiwiaWF0IjoxNzU4NDIxNDY5LCJleHAiOjE3NTkwMjYyNjl9.NT5BgMf70Bxob-QvQvABnrIOmKKBLPF3Ul8zVTsGIq0

### 11. تصحيح إجابات طالب
POST http://localhost:8000/api/essay-exams/exams/1/students/5/grade
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MSwiZW1haWwiOiJhZG1pbkBleGFtcGxlLmNvbSIsInJvbGUiOiJhZG1pbiIsImp0aSI6InRlc3QtanRpIiwiaWF0IjoxNzU4NDIxNDY5LCJleHAiOjE3NTkwMjYyNjl9.NT5BgMf70Bxob-QvQvABnrIOmKKBLPF3Ul8zVTsGIq0
Content-Type: application/json

{
  "total_grade": 85,
  "max_grade": 100,
  "feedback": "إجابة ممتازة مع أمثلة واضحة، لكن يمكن تحسين الشرح في الجزء الأخير"
}

