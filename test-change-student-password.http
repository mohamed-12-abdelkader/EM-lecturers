### اختبار API تغيير كلمة سر الطالب (للأدمن)

# تغيير كلمة سر الطالب
PATCH {{baseUrl}}/api/users/students/1/password
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "new_password": "123456"
}

###

# تغيير كلمة سر طالب آخر
PATCH {{baseUrl}}/api/users/students/5/password
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "new_password": "newpassword123"
}

###

# اختبار بدون token (يجب أن يعطي خطأ 401)
PATCH {{baseUrl}}/api/users/students/1/password
Content-Type: application/json

{
  "new_password": "123456"
}

###

# اختبار مع token طالب (يجب أن يعطي خطأ 403)
PATCH {{baseUrl}}/api/users/students/1/password
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "new_password": "123456"
}

###

# اختبار كلمة سر قصيرة جداً (يجب أن يعطي خطأ 400)
PATCH {{baseUrl}}/api/users/students/1/password
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "new_password": "123"
}

###

# اختبار بدون كلمة سر (يجب أن يعطي خطأ 400)
PATCH {{baseUrl}}/api/users/students/1/password
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{

}

###

# اختبار مع معرف طالب غير موجود (يجب أن يعطي خطأ 404)
PATCH {{baseUrl}}/api/users/students/999/password
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "new_password": "123456"
}

###

### اختبار API تغيير كلمة سر الطالب (للطالب نفسه باستخدام رقم الهاتف)

# تغيير كلمة سر الطالب باستخدام رقم الهاتف
POST {{baseUrl}}/api/student/change-password
Content-Type: application/json

{
  "phone": "01000000000",
  "new_password": "newpassword123"
}

###

# اختبار مع رقم هاتف غير موجود (يجب أن يعطي خطأ 404)
POST {{baseUrl}}/api/student/change-password
Content-Type: application/json

{
  "phone": "99999999999",
  "new_password": "newpassword123"
}

###

# اختبار كلمة سر قصيرة جداً (يجب أن يعطي خطأ 400)
POST {{baseUrl}}/api/student/change-password
Content-Type: application/json

{
  "phone": "01000000000",
  "new_password": "123"
}

###

# اختبار بدون رقم هاتف (يجب أن يعطي خطأ 400)
POST {{baseUrl}}/api/student/change-password
Content-Type: application/json

{
  "new_password": "newpassword123"
}

###

# اختبار بدون كلمة سر (يجب أن يعطي خطأ 400)
POST {{baseUrl}}/api/student/change-password
Content-Type: application/json

{
  "phone": "01000000000"
}

###

# اختبار مع رقم هاتف غير صحيح (يجب أن يعطي خطأ 400)
POST {{baseUrl}}/api/student/change-password
Content-Type: application/json

{
  "phone": "123",
  "new_password": "newpassword123"
}


